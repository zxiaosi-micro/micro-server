# 构建产物
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# 运行日志（*_run.log：本地服务日志约定，不入库；Promtail 只采集本地目录）
*_run.log
logs/

# 密钥与本地环境（E11：密钥出仓，环境变量注入；${ENV} 占位符 yaml 可入库）
keys/
# 例外：服务源码包 internal/keys（密钥加载器，S3-02）非真实密钥目录
!services/*/internal/keys/
!services/*/internal/keys/**
*.key
.env
.env.*
!.env.example

# 覆盖率
coverage.out
coverage.html

# IDE / 系统
.idea/
.vscode/
.DS_Store
go.mod
