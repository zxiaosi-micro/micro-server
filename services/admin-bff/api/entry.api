syntax = "v1"

info (
	title:                       "AdminBff"
	desc:                        "管理后台 BFF REST 契约（S3-03）。统一信封 {code,msg,data}（wrapCodeMsg）；认证码 10401~10406 → HTTP 401（10401 静默刷新 / 10402 互斥弹窗 / 10406 提级弹窗）；权限 10408 → 403。所有 ID 字段字符串传输与渲染（E8）。"
	author:                      "micro"
	version:                     "v1"
	wrapCodeMsg:                 true
	useDefinitions:              true
	securityDefinitionsFromJson: `{"bearerAuth":{"type":"apiKey","in":"header","name":"Authorization","description":"Bearer <access_token>"}}`
)

// ============================================================
// 类型（ID 一律 string；时间 UnixMilli int64 字符串化由前端渲染）
// ============================================================
type LoginReq {
	Mobile   string `json:"mobile"`
	Password string `json:"password"`
}

type TokenPair {
	AccessToken      string `json:"access_token"`
	RefreshToken     string `json:"refresh_token"`
	AccessExpiresIn  int64  `json:"access_expires_in"`
	RefreshExpiresIn int64  `json:"refresh_expires_in"`
}

type LoginResp {
	Tokens   TokenPair `json:"tokens"`
	UID      string    `json:"uid"`
	Nickname string    `json:"nickname"`
}

type RefreshReq {
	RefreshToken string `json:"refresh_token"`
}

type RefreshResp {
	Tokens TokenPair `json:"tokens"`
}

type StepUpReq {
	Password string `json:"password"`
}

type StepUpResp {
	Level           int    `json:"level"`
	AccessToken     string `json:"access_token"`
	AccessExpiresIn int64  `json:"access_expires_in"`
}

type MeResp {
	UID       string   `json:"uid"`
	Nickname  string   `json:"nickname"`
	Mobile    string   `json:"mobile"` // 脱敏
	TenantID  string   `json:"tenant_id"`
	Roles     []string `json:"roles"`
	Perms     []string `json:"perms"`
	DataScope string   `json:"data_scope"`
}

type MenuItem {
	MenuID   string `json:"menu_id"`
	ParentID string `json:"parent_id"`
	Name     string `json:"name"`
	Type     int    `json:"type"` // 1 目录 / 2 菜单 / 3 按钮 / 4 接口
	PermCode string `json:"perm_code"`
	Path     string `json:"path"`
	Icon     string `json:"icon"`
	Sort     int    `json:"sort"`
	Status   int    `json:"status"`
}

type MenusResp {
	Menus []MenuItem `json:"menus"` // 平铺，前端组树
	Perms []string   `json:"perms"` // 按钮级权限码
}

// ---- 用户 ----
type UserItem {
	UID          string   `json:"uid"`
	OrgID        string   `json:"org_id"`
	PartyID      string   `json:"party_id"`
	Nickname     string   `json:"nickname"`
	MobileMasked string   `json:"mobile_masked"`
	EmailMasked  string   `json:"email_masked"`
	Types        []string `json:"types"` // 可登录端
	Status       int      `json:"status"`
	LockedUntil  string   `json:"locked_until"` // UnixMilli 字符串，空=未锁
	RoleCodes    []string `json:"role_codes"`
	CreatedAt    string   `json:"created_at"`
}

type UserListReq {
	Page    int    `form:"page,range=[1:10000]"`
	Size    int    `form:"size,range=[1:100]"` // 分页上限 100（S3-04 usePaged 同源）
	Keyword string `form:"keyword,optional"`
	Status  int    `form:"status,optional"` // 0 全部
}

type UserListResp {
	List  []UserItem `json:"list"`
	Total int64      `json:"total"`
}

type UserCreateReq {
	Nickname string   `json:"nickname"`
	Mobile   string   `json:"mobile"`
	Email    string   `json:"email,optional"`
	Password string   `json:"password"`
	Types    []string `json:"types"`
	OrgID    string   `json:"org_id,optional"`
	RoleIDs  []string `json:"role_ids,optional"`
}

type UserUpdateReq {
	UID      string   `path:"id"`
	Nickname string   `json:"nickname,optional"`
	Mobile   string   `json:"mobile,optional"`
	Email    string   `json:"email,optional"`
	Types    []string `json:"types,optional"`
	OrgID    string   `json:"org_id,optional"`
	RoleIDs  []string `json:"role_ids,optional"`
}

type UserStatusReq {
	UID    string `path:"id"`
	Status int    `json:"status"` // 1 恢复 / 2 禁用
}

type UserPasswordReq {
	UID         string `path:"id"`
	NewPassword string `json:"new_password"`
}

type IDPath {
	ID string `path:"id"`
}

type SimpleResp {
	UID string `json:"uid,optional"`
}

// ---- 角色 ----
type RoleItem {
	RoleID    string `json:"role_id"`
	Code      string `json:"code"`
	Name      string `json:"name"`
	DataScope string `json:"data_scope"` // JSON {"type":"ALL"|"SELF"|"ORG","org_ids":[...]}
	Remark    string `json:"remark"`
	CreatedAt string `json:"created_at"`
}

type RoleListReq {
	Page    int    `form:"page,range=[1:10000]"`
	Size    int    `form:"size,range=[1:100]"`
	Keyword string `form:"keyword,optional"`
}

type RoleListResp {
	List  []RoleItem `json:"list"`
	Total int64      `json:"total"`
}

type RoleCreateReq {
	Code      string   `json:"code"`
	Name      string   `json:"name"`
	DataScope string   `json:"data_scope,optional"`
	Remark    string   `json:"remark,optional"`
	MenuIDs   []string `json:"menu_ids,optional"`
}

type RoleUpdateReq {
	RoleID    string   `path:"id"`
	Name      string   `json:"name,optional"`
	DataScope string   `json:"data_scope,optional"`
	Remark    string   `json:"remark,optional"`
	MenuIDs   []string `json:"menu_ids,optional"` // 传空数组=清空；不传=不变更
}

type RoleDetailResp {
	Role    RoleItem `json:"role"`
	MenuIDs []string `json:"menu_ids"`
}

// ---- 组织 ----
type OrgItem {
	OrgID    string `json:"org_id"`
	ParentID string `json:"parent_id"`
	Name     string `json:"name"`
	Sort     int    `json:"sort"`
}

type OrgListResp {
	List []OrgItem `json:"list"` // 平铺，前端组树
}

type OrgCreateReq {
	ParentID string `json:"parent_id,optional"`
	Name     string `json:"name"`
	Sort     int    `json:"sort,optional"`
}

type OrgUpdateReq {
	OrgID    string `path:"id"`
	ParentID string `json:"parent_id,optional"`
	Name     string `json:"name,optional"`
	Sort     int    `json:"sort,optional"`
}

// ---- 菜单 ----
type MenuListResp {
	List []MenuItem `json:"list"`
}

type MenuCreateReq {
	ParentID string `json:"parent_id,optional"`
	Name     string `json:"name"`
	Type     int    `json:"type"`
	PermCode string `json:"perm_code,optional"`
	Path     string `json:"path,optional"`
	Icon     string `json:"icon,optional"`
	Sort     int    `json:"sort,optional"`
}

type MenuUpdateReq {
	MenuID   string `path:"id"`
	ParentID string `json:"parent_id,optional"`
	Name     string `json:"name,optional"`
	Type     int    `json:"type,optional"`
	PermCode string `json:"perm_code,optional"`
	Path     string `json:"path,optional"`
	Icon     string `json:"icon,optional"`
	Sort     int    `json:"sort,optional"`
	Status   int    `json:"status,optional"`
}

// ---- 租户 ----
type TenantItem {
	TenantID   string `json:"tenant_id"`
	TenantCode string `json:"tenant_code"`
	Name       string `json:"name"`
	Plan       string `json:"plan"`
	Quota      string `json:"quota"` // JSON
	Status     int    `json:"status"`
}

type TenantListReq {
	Page    int    `form:"page,range=[1:10000]"`
	Size    int    `form:"size,range=[1:100]"`
	Keyword string `form:"keyword,optional"`
}

type TenantListResp {
	List  []TenantItem `json:"list"`
	Total int64        `json:"total"`
}

type TenantCreateReq {
	TenantCode string `json:"tenant_code"`
	Name       string `json:"name"`
	Plan       string `json:"plan,optional"`
	Quota      string `json:"quota,optional"`
}

type TenantUpdateReq {
	TenantID string `path:"id"`
	Name     string `json:"name,optional"`
	Plan     string `json:"plan,optional"`
	Status   int    `json:"status,optional"`
}

type TenantQuotaReq {
	TenantID string `path:"id"`
	Quota    string `json:"quota"`
}

// ---- 会话 ----
type SessionItem {
	SID       string `json:"sid"`
	Client    string `json:"client"`
	CreatedAt string `json:"created_at"`
}

type SessionListReq {
	UID    string `form:"uid,optional"` // 空=自己
	Client string `form:"client,optional"`
}

type SessionListResp {
	List []SessionItem `json:"list"`
}

type SessionKickReq {
	UID    string `json:"uid,optional"`
	Client string `json:"client,optional"`
	SID    string `json:"sid,optional"`
}

type SessionKickResp {
	Kicked int64 `json:"kicked"`
}

// ============================================================
// 免鉴权组（authz SkipPaths=/auth/* /sso/*；logout/step-up 在 handler
// 内自行解析 Bearer 取 sid——登出与提级不需要完整鉴权链）
// ============================================================
@server (
	prefix: /api/v1
	group:  auth
)
service AdminBffApi {
	@doc "密码登录（10400 凭证错误 / 10407 锁定倒计时）"
	@handler login
	post /auth/login (LoginReq) returns (LoginResp)

	@doc "刷新（前端 request.ts 单飞调用；后端轮换式）"
	@handler refresh
	post /auth/refresh (RefreshReq) returns (RefreshResp)

	@doc "登出"
	@handler logout
	post /auth/logout returns (SimpleResp)

	@doc "二次认证提级（5min 窗口 level=2）"
	@handler stepUp
	post /auth/step-up (StepUpReq) returns (StepUpResp)
}

// ============================================================
// 鉴权组（authz 中间件：验签→会话→client→RBAC 每请求 GET auth_cache）
// ============================================================
@server (
	prefix:     /api/v1
	group:      auth
	middleware: Authz
)
service AdminBffApi {
	@doc "当前用户信息"
	@handler me
	get /auth/me returns (MeResp)

	@doc "用户可见菜单与权限码"
	@handler menus
	get /auth/menus returns (MenusResp)
}

@server (
	prefix:     /api/v1
	group:      user
	middleware: Authz
)
service AdminBffApi {
	@doc "用户列表（perm: system:user:list）"
	@handler listUsers
	get /users (UserListReq) returns (UserListResp)

	@doc "新建用户（perm: system:user:create）"
	@handler createUser
	post /users (UserCreateReq) returns (SimpleResp)

	@doc "用户详情（perm: system:user:list）"
	@handler getUser
	get /users/:id (IDPath) returns (UserItem)

	@doc "编辑用户（perm: system:user:update）"
	@handler updateUser
	put /users/:id (UserUpdateReq) returns (SimpleResp)

	@doc "禁用/恢复（perm: system:user:status；禁用即时踢全部会话）"
	@handler updateUserStatus
	put /users/:id/status (UserStatusReq) returns (SimpleResp)

	@doc "重置密码（perm: system:user:reset-pwd）"
	@handler resetUserPassword
	put /users/:id/password (UserPasswordReq) returns (SimpleResp)

	@doc "删除用户（perm: system:user:delete）"
	@handler deleteUser
	delete /users/:id (IDPath) returns (SimpleResp)
}

@server (
	prefix:     /api/v1
	group:      role
	middleware: Authz
)
service AdminBffApi {
	@doc "角色列表（perm: system:role:list）"
	@handler listRoles
	get /roles (RoleListReq) returns (RoleListResp)

	@doc "新建角色（perm: system:role:create）"
	@handler createRole
	post /roles (RoleCreateReq) returns (SimpleResp)

	@doc "角色详情+权限树回显（perm: system:role:list）"
	@handler getRole
	get /roles/:id (IDPath) returns (RoleDetailResp)

	@doc "编辑角色（perm: system:role:update；联动失效相关用户 auth_cache）"
	@handler updateRole
	put /roles/:id (RoleUpdateReq) returns (SimpleResp)

	@doc "删除角色（perm: system:role:delete）"
	@handler deleteRole
	delete /roles/:id (IDPath) returns (SimpleResp)
}

@server (
	prefix:     /api/v1
	group:      org
	middleware: Authz
)
service AdminBffApi {
	@doc "组织树（perm: system:org:list）"
	@handler listOrgs
	get /orgs returns (OrgListResp)

	@doc "新建组织（perm: system:org:create）"
	@handler createOrg
	post /orgs (OrgCreateReq) returns (SimpleResp)

	@doc "编辑组织（perm: system:org:update）"
	@handler updateOrg
	put /orgs/:id (OrgUpdateReq) returns (SimpleResp)

	@doc "删除组织（perm: system:org:delete）"
	@handler deleteOrg
	delete /orgs/:id (IDPath) returns (SimpleResp)
}

@server (
	prefix:     /api/v1
	group:      menu
	middleware: Authz
)
service AdminBffApi {
	@doc "菜单管理列表（perm: system:menu:list）"
	@handler listMenus
	get /menus returns (MenuListResp)

	@doc "新建菜单（perm: system:menu:create）"
	@handler createMenu
	post /menus (MenuCreateReq) returns (SimpleResp)

	@doc "编辑菜单（perm: system:menu:update）"
	@handler updateMenu
	put /menus/:id (MenuUpdateReq) returns (SimpleResp)

	@doc "删除菜单（perm: system:menu:delete）"
	@handler deleteMenu
	delete /menus/:id (IDPath) returns (SimpleResp)
}

@server (
	prefix:     /api/v1
	group:      tenant
	middleware: Authz
)
service AdminBffApi {
	@doc "租户列表（perm: system:tenant:list；平台面）"
	@handler listTenants
	get /tenants (TenantListReq) returns (TenantListResp)

	@doc "新建租户（perm: system:tenant:create）"
	@handler createTenant
	post /tenants (TenantCreateReq) returns (SimpleResp)

	@doc "编辑租户（perm: system:tenant:update）"
	@handler updateTenant
	put /tenants/:id (TenantUpdateReq) returns (SimpleResp)

	@doc "配额设置（perm: system:tenant:quota）"
	@handler updateTenantQuota
	put /tenants/:id/quota (TenantQuotaReq) returns (SimpleResp)

	@doc "删除租户（perm: system:tenant:update）"
	@handler deleteTenant
	delete /tenants/:id (IDPath) returns (SimpleResp)
}

@server (
	prefix:     /api/v1
	group:      session
	middleware: Authz
)
service AdminBffApi {
	@doc "在线会话列表（perm: system:session:list；uid 空=自己）"
	@handler listSessions
	get /sessions (SessionListReq) returns (SessionListResp)

	@doc "踢下线（perm: system:session:kick；sid 定点 / uid+client 该端 / uid 全端）"
	@handler kickSessions
	post /sessions/kick (SessionKickReq) returns (SessionKickResp)
}

// ============================================================
// S4 业务域（S4-05）：party / catalog / inventory / notification / audit
// 全部走对应 RPC 转发；ID 一律 string（E8）；金额 DECIMAL 字符串。
// ============================================================
// ---- 参与方 ----
type PartyItem {
	PartyID    string   `json:"party_id"`
	Name       string   `json:"name"`
	Type       []string `json:"type"` // JSON SET 语义:多类型并存
	Status     int      `json:"status"`
	CreditCode string   `json:"credit_code"`
	Region     string   `json:"region"`
	Address    string   `json:"address"`
	Remark     string   `json:"remark"`
	CreatedAt  int64    `json:"created_at"`
	UpdatedAt  int64    `json:"updated_at"`
}

type PartyListReq {
	Page    int    `form:"page,range=[1:10000]"`
	Size    int    `form:"size,range=[1:100]"`
	Keyword string `form:"keyword,optional"`
	Type    string `form:"type,optional"`
	Status  int    `form:"status,optional"`
}

type PartyListResp {
	List  []PartyItem `json:"list"`
	Total int64       `json:"total"`
}

type PartyCreateReq {
	Name       string   `json:"name"`
	Type       []string `json:"type"`
	CreditCode string   `json:"credit_code,optional"`
	Region     string   `json:"region,optional"`
	Address    string   `json:"address,optional"`
	Remark     string   `json:"remark,optional"`
}

type PartyUpdateReq {
	Id         string   `path:"id"`
	Name       string   `json:"name"`
	Type       []string `json:"type"`
	Status     int      `json:"status,optional"`
	CreditCode string   `json:"credit_code,optional"`
	Region     string   `json:"region,optional"`
	Address    string   `json:"address,optional"`
	Remark     string   `json:"remark,optional"`
}

type PartyDetailResp {
	Party PartyItem `json:"party"`
}

type ContactItem {
	ContactID  string `json:"contact_id"`
	PartyID    string `json:"party_id"`
	Name       string `json:"name"`
	Mobile     string `json:"mobile"`
	Position   string `json:"position"`
	IsDefault  bool   `json:"is_default"`
	NotifyPref string `json:"notify_pref"`
	CreatedAt  int64  `json:"created_at"`
}

type ContactListResp {
	List []ContactItem `json:"list"`
}

type ContactCreateReq {
	Id         string `path:"id"`
	Name       string `json:"name"`
	Mobile     string `json:"mobile"`
	Position   string `json:"position,optional"`
	IsDefault  bool   `json:"is_default,optional"`
	NotifyPref string `json:"notify_pref,optional"`
}

type CrmRecordItem {
	RecordID     string `json:"record_id"`
	PartyID      string `json:"party_id"`
	Content      string `json:"content"`
	NextFollowAt int64  `json:"next_follow_at"`
	CreatedBy    string `json:"created_by"`
	CreatedAt    int64  `json:"created_at"`
}

type CrmRecordListResp {
	List []CrmRecordItem `json:"list"`
}

type CrmRecordCreateReq {
	Id           string `path:"id"`
	Content      string `json:"content"`
	NextFollowAt int64  `json:"next_follow_at,optional"`
}

type StaffItem {
	StaffID    string   `json:"staff_id"`
	PartyID    string   `json:"party_id"`
	UserID     string   `json:"user_id"`
	Name       string   `json:"name"`
	StaffType  string   `json:"staff_type"`
	SkillTags  []string `json:"skill_tags"`
	WorkRegion string   `json:"work_region"`
	Status     int      `json:"status"`
	CreatedAt  int64    `json:"created_at"`
}

type StaffListResp {
	List  []StaffItem `json:"list"`
	Total int64       `json:"total"`
}

type StaffCreateReq {
	PartyID    string   `json:"party_id"`
	UserID     string   `json:"user_id,optional"`
	Name       string   `json:"name"`
	StaffType  string   `json:"staff_type,optional"`
	SkillTags  []string `json:"skill_tags,optional"`
	WorkRegion string   `json:"work_region,optional"`
}

type DealerExtItem {
	PartyID          string `json:"party_id"`
	DealerLevel      string `json:"dealer_level"`
	AuthorizedRegion string `json:"authorized_region"`
	RebateRule       string `json:"rebate_rule"`
	UpdatedAt        int64  `json:"updated_at"`
}

type DealerExtResp {
	DealerExt DealerExtItem `json:"dealer_ext"`
}

type DealerExtUpsertReq {
	Id               string `path:"id"`
	DealerLevel      string `json:"dealer_level,optional"`
	AuthorizedRegion string `json:"authorized_region,optional"`
	RebateRule       string `json:"rebate_rule,optional"`
}

// ---- 商机 ----
type OpportunityItem {
	OpportunityID string `json:"opportunity_id"`
	PartyID       string `json:"party_id"`
	PartyName     string `json:"party_name"`
	Title         string `json:"title"`
	Stage         string `json:"stage"`
	Amount        string `json:"amount"`
	ExpectedClose int64  `json:"expected_close_date"`
	Remark        string `json:"remark"`
	CreatedAt     int64  `json:"created_at"`
	UpdatedAt     int64  `json:"updated_at"`
}

type OpportunityListReq {
	Page    int    `form:"page,range=[1:10000]"`
	Size    int    `form:"size,range=[1:100]"`
	PartyID string `form:"party_id,optional"`
	Stage   string `form:"stage,optional"`
	Keyword string `form:"keyword,optional"`
}

type OpportunityListResp {
	List  []OpportunityItem `json:"list"`
	Total int64             `json:"total"`
}

type OpportunityCreateReq {
	PartyID       string `json:"party_id"`
	Title         string `json:"title"`
	Amount        string `json:"amount,optional"`
	ExpectedClose int64  `json:"expected_close_date,optional"`
	Remark        string `json:"remark,optional"`
}

type OpportunityStageReq {
	Id    string `path:"id"`
	Stage string `json:"stage"`
}

// ---- 商品 ----
type ProductItem {
	ProductID string `json:"product_id"`
	Name      string `json:"name"`
	Category  string `json:"category"`
	Status    int    `json:"status"`
	Remark    string `json:"remark"`
	CreatedAt int64  `json:"created_at"`
}

type ProductListReq {
	Page    int    `form:"page,range=[1:10000]"`
	Size    int    `form:"size,range=[1:100]"`
	Keyword string `form:"keyword,optional"`
	Status  int    `form:"status,optional"`
}

type ProductListResp {
	List  []ProductItem `json:"list"`
	Total int64         `json:"total"`
}

type ProductCreateReq {
	Name     string `json:"name"`
	Category string `json:"category,optional"`
	Remark   string `json:"remark,optional"`
}

type SkuItem {
	SkuID     string `json:"sku_id"`
	ProductID string `json:"product_id"`
	Code      string `json:"code"`
	Name      string `json:"name"`
	Type      string `json:"type"` // STANDARD/EXT_WARRANTY
	Spec      string `json:"spec"`
	Status    int    `json:"status"`
	CreatedAt int64  `json:"created_at"`
}

type SkuListReq {
	Page      int    `form:"page,range=[1:10000]"`
	Size      int    `form:"size,range=[1:100]"`
	ProductID string `form:"product_id,optional"`
	Keyword   string `form:"keyword,optional"`
}

type SkuListResp {
	List  []SkuItem `json:"list"`
	Total int64     `json:"total"`
}

type SkuCreateReq {
	ProductID string `json:"product_id"`
	Code      string `json:"code"`
	Name      string `json:"name"`
	Type      string `json:"type,optional"`
	Spec      string `json:"spec,optional"`
}

type PriceItem {
	PriceID   string `json:"price_id"`
	SkuID     string `json:"sku_id"`
	PriceType string `json:"price_type"` // RETAIL/DEALER/TIER
	TierQty   int    `json:"tier_qty"`
	Amount    string `json:"amount"`
	Version   int    `json:"version"`
	CreatedAt int64  `json:"created_at"`
}

type PriceListReq {
	SkuID      string `form:"sku_id"`
	LatestOnly bool   `form:"latest_only,optional"`
}

type PriceListResp {
	List  []PriceItem `json:"list"`
	Total int64       `json:"total"`
}

type PriceSetReq {
	Id        string `path:"id"`
	PriceType string `json:"price_type"`
	TierQty   int    `json:"tier_qty,optional"`
	Amount    string `json:"amount"`
}

type PriceSetResp {
	Version int `json:"version"`
}

type WarrantyPolicyItem {
	SkuID        string `json:"sku_id"`
	PeriodMonths int    `json:"period_months"`
	StartRule    string `json:"start_rule"` // ACTIVATION/RECEIPT
}

type WarrantyPolicyUpsertReq {
	Id           string `path:"id"`
	PeriodMonths int    `json:"period_months"`
	StartRule    string `json:"start_rule"`
}

type StationProductItem {
	StationProductID string    `json:"station_product_id"`
	Name             string    `json:"name"`
	Remark           string    `json:"remark"`
	Items            []BomItem `json:"items,optional"`
	CreatedAt        int64     `json:"created_at"`
}

type BomItem {
	SkuID   string `json:"sku_id"`
	SkuName string `json:"sku_name"`
	Qty     int    `json:"qty"`
}

type StationProductListReq {
	Page    int    `form:"page,range=[1:10000]"`
	Size    int    `form:"size,range=[1:100]"`
	Keyword string `form:"keyword,optional"`
}

type StationProductListResp {
	List  []StationProductItem `json:"list"`
	Total int64                `json:"total"`
}

type StationProductCreateReq {
	Name   string    `json:"name"`
	Remark string    `json:"remark,optional"`
	Items  []BomItem `json:"items"`
}

type StationProductDetailResp {
	StationProduct StationProductItem `json:"station_product"`
}

// ---- 库存 ----
type WarehouseItem {
	WarehouseID string `json:"warehouse_id"`
	Code        string `json:"code"`
	Name        string `json:"name"`
	Address     string `json:"address"`
	Status      int    `json:"status"`
	CreatedAt   int64  `json:"created_at"`
}

type WarehouseListReq {
	Page    int    `form:"page,range=[1:10000]"`
	Size    int    `form:"size,range=[1:100]"`
	Keyword string `form:"keyword,optional"`
}

type WarehouseListResp {
	List  []WarehouseItem `json:"list"`
	Total int64           `json:"total"`
}

type WarehouseCreateReq {
	Code    string `json:"code"`
	Name    string `json:"name"`
	Address string `json:"address,optional"`
}

type InventoryItem {
	InventoryID       string `json:"inventory_id"`
	WarehouseID       string `json:"warehouse_id"`
	SkuID             string `json:"sku_id"`
	Available         int    `json:"available"`
	Locked            int    `json:"locked"`
	InTransit         int    `json:"in_transit"`
	Defective         int    `json:"defective"`
	LowStockThreshold int    `json:"low_stock_threshold"`
	UpdatedAt         int64  `json:"updated_at"`
}

type InventoryListReq {
	Page        int    `form:"page,range=[1:10000]"`
	Size        int    `form:"size,range=[1:100]"`
	WarehouseID string `form:"warehouse_id,optional"`
	SkuID       string `form:"sku_id,optional"`
	LowOnly     bool   `form:"low_only,optional"`
}

type InventoryListResp {
	List  []InventoryItem `json:"list"`
	Total int64           `json:"total"`
}

type StockOpReq {
	WarehouseID string `json:"warehouse_id"`
	SkuID       string `json:"sku_id"`
	Qty         int    `json:"qty"`
	BizType     string `json:"biz_type,optional"`
	BizNo       string `json:"biz_no,optional"`
	Remark      string `json:"remark,optional"`
}

type StockOpResp {
	RecordID string `json:"record_id"`
}

type StockRecordItem {
	RecordID        string `json:"record_id"`
	InventoryID     string `json:"inventory_id"`
	WarehouseID     string `json:"warehouse_id"`
	SkuID           string `json:"sku_id"`
	BizType         string `json:"biz_type"`
	BizNo           string `json:"biz_no"`
	Qty             int    `json:"qty"`
	BeforeAvailable int    `json:"before_available"`
	AfterAvailable  int    `json:"after_available"`
	BeforeLocked    int    `json:"before_locked"`
	AfterLocked     int    `json:"after_locked"`
	Remark          string `json:"remark"`
	CreatedAt       int64  `json:"created_at"`
}

type StockRecordListReq {
	Page        int    `form:"page,range=[1:10000]"`
	Size        int    `form:"size,range=[1:100]"`
	WarehouseID string `form:"warehouse_id,optional"`
	SkuID       string `form:"sku_id,optional"`
	BizType     string `form:"biz_type,optional"`
}

type StockRecordListResp {
	List  []StockRecordItem `json:"list"`
	Total int64             `json:"total"`
}

type StocktakeItem {
	ItemID     string `json:"item_id"`
	SkuID      string `json:"sku_id"`
	BookQty    int    `json:"book_qty"`
	CountedQty int    `json:"counted_qty"` // 未提交 = -1
	DiffQty    int    `json:"diff_qty"`
}

type StocktakeRecord {
	StocktakeID string          `json:"stocktake_id"`
	WarehouseID string          `json:"warehouse_id"`
	Status      int             `json:"status"` // 1 草稿/2 已提交/3 已审批/4 已驳回
	Remark      string          `json:"remark"`
	Items       []StocktakeItem `json:"items,optional"`
	CreatedAt   int64           `json:"created_at"`
}

type StocktakeCreateReq {
	WarehouseID string `json:"warehouse_id"`
	Remark      string `json:"remark,optional"`
}

type StocktakeSubmitItem {
	SkuID      string `json:"sku_id"`
	CountedQty int    `json:"counted_qty"`
}

type StocktakeSubmitReq {
	Id    string                `path:"id"`
	Items []StocktakeSubmitItem `json:"items"`
}

type StocktakeApproveReq {
	Id      string `path:"id"`
	Approve bool   `json:"approve"`
	Remark  string `json:"remark,optional"`
}

type StocktakeListReq {
	Page        int    `form:"page,range=[1:10000]"`
	Size        int    `form:"size,range=[1:100]"`
	WarehouseID string `form:"warehouse_id,optional"`
	Status      int    `form:"status,optional"`
}

type StocktakeListResp {
	List  []StocktakeRecord `json:"list"`
	Total int64             `json:"total"`
}

type StocktakeDetailResp {
	Stocktake StocktakeRecord `json:"stocktake"`
}

// ---- 消息 ----
type MessageItem {
	MessageID string `json:"message_id"`
	UserID    string `json:"user_id"`
	Title     string `json:"title"`
	Content   string `json:"content"`
	IsRead    bool   `json:"is_read"`
	BizType   string `json:"biz_type"`
	BizID     string `json:"biz_id"`
	CreatedAt int64  `json:"created_at"`
}

type MessageListReq {
	Page       int    `form:"page,range=[1:10000]"`
	Size       int    `form:"size,range=[1:100]"`
	UserID     string `form:"user_id,optional"`
	OnlyUnread bool   `form:"only_unread,optional"`
}

type MessageListResp {
	List  []MessageItem `json:"list"`
	Total int64         `json:"total"`
}

type UnreadCountResp {
	Count int64 `json:"count"`
}

type TemplateItem {
	TemplateID      string `json:"template_id"`
	Code            string `json:"code"`
	TitleTemplate   string `json:"title_template"`
	ContentTemplate string `json:"content_template"`
	Channel         string `json:"channel"`
	Status          int    `json:"status"`
}

type TemplateListReq {
	Page    int    `form:"page,range=[1:10000]"`
	Size    int    `form:"size,range=[1:100]"`
	Keyword string `form:"keyword,optional"`
}

type TemplateListResp {
	List  []TemplateItem `json:"list"`
	Total int64          `json:"total"`
}

type TemplateUpsertReq {
	Code            string `json:"code"`
	TitleTemplate   string `json:"title_template"`
	ContentTemplate string `json:"content_template"`
	Channel         string `json:"channel,optional"`
	Status          int    `json:"status,optional"`
}

type NotifySettingItem {
	UserID       string `json:"user_id"`
	TemplateCode string `json:"template_code"`
	Enabled      bool   `json:"enabled"`
	QuietHours   string `json:"quiet_hours"`
}

type NotifySettingListReq {
	UserID string `form:"user_id"`
}

type NotifySettingListResp {
	List []NotifySettingItem `json:"list"`
}

type NotifySettingUpsertReq {
	UserID       string `json:"user_id,optional"`
	TemplateCode string `json:"template_code"`
	Enabled      bool   `json:"enabled"`
	QuietHours   string `json:"quiet_hours,optional"`
}

// ---- 审计 ----
type AuditLogItem {
	LogID      string `json:"log_id"`
	TraceID    string `json:"trace_id"`
	UID        string `json:"uid"`
	Action     string `json:"action"`
	TargetType string `json:"target_type"`
	TargetID   string `json:"target_id"`
	BeforeJson string `json:"before_json"`
	AfterJson  string `json:"after_json"`
	Result     string `json:"result"`
	Client     string `json:"client"`
	OnBehalfOf string `json:"on_behalf_of"`
	CreatedAt  int64  `json:"created_at"`
}

type AuditLogListReq {
	Page       int    `form:"page,range=[1:10000]"`
	Size       int    `form:"size,range=[1:100]"`
	Action     string `form:"action,optional"`
	UID        string `form:"uid,optional"`
	TargetType string `form:"target_type,optional"`
	TargetID   string `form:"target_id,optional"`
}

type AuditLogListResp {
	List  []AuditLogItem `json:"list"`
	Total int64          `json:"total"`
}

type CmdAuditItem {
	CmdAuditID  string `json:"cmd_audit_id"`
	CmdID       string `json:"cmd_id"`
	SN          string `json:"sn"`
	UID         string `json:"uid"`
	Action      string `json:"action"`
	PayloadJson string `json:"payload_json"`
	Result      string `json:"result"`
	Error       string `json:"error"`
	TraceID     string `json:"trace_id"`
	CreatedAt   int64  `json:"created_at"`
}

type CmdAuditListReq {
	Page  int    `form:"page,range=[1:10000]"`
	Size  int    `form:"size,range=[1:100]"`
	SN    string `form:"sn,optional"`
	CmdID string `form:"cmd_id,optional"`
}

type CmdAuditListResp {
	List  []CmdAuditItem `json:"list"`
	Total int64          `json:"total"`
}

// ---- 参与方路由 ----
@server (
	prefix:     /api/v1
	group:      party
	middleware: Authz
)
service AdminBffApi {
	@doc "参与方列表(perm: party:party:list)"
	@handler listParties
	get /parties (PartyListReq) returns (PartyListResp)

	@doc "新建参与方(perm: party:party:create)"
	@handler createParty
	post /parties (PartyCreateReq) returns (SimpleResp)

	@doc "参与方详情(perm: party:party:list)"
	@handler getParty
	get /parties/:id (IDPath) returns (PartyDetailResp)

	@doc "编辑参与方(perm: party:party:update)"
	@handler updateParty
	put /parties/:id (PartyUpdateReq) returns (SimpleResp)

	@doc "联系人列表(perm: party:party:list)"
	@handler listContacts
	get /parties/:id/contacts (IDPath) returns (ContactListResp)

	@doc "新增联系人(perm: party:contact:create)"
	@handler addContact
	post /parties/:id/contacts (ContactCreateReq) returns (SimpleResp)

	@doc "跟进记录(perm: party:party:list)"
	@handler listCrmRecords
	get /parties/:id/crm (IDPath) returns (CrmRecordListResp)

	@doc "追加跟进(perm: party:crm:create)"
	@handler addCrmRecord
	post /parties/:id/crm (CrmRecordCreateReq) returns (SimpleResp)

	@doc "员工列表(perm: party:party:list)"
	@handler listStaff
	get /parties/:id/staff (IDPath) returns (StaffListResp)

	@doc "新建员工(perm: party:staff:create)"
	@handler createStaff
	post /staff (StaffCreateReq) returns (SimpleResp)

	@doc "经销商扩展(perm: party:party:list)"
	@handler getDealerExt
	get /parties/:id/dealer-ext (IDPath) returns (DealerExtResp)

	@doc "经销商扩展 Upsert(perm: party:dealer:update)"
	@handler upsertDealerExt
	put /parties/:id/dealer-ext (DealerExtUpsertReq) returns (SimpleResp)
}

// ---- 商机路由 ----
@server (
	prefix:     /api/v1
	group:      party
	middleware: Authz
)
service AdminBffApi {
	@doc "商机列表(perm: party:opportunity:list)"
	@handler listOpportunities
	get /opportunities (OpportunityListReq) returns (OpportunityListResp)

	@doc "新建商机(perm: party:opportunity:create)"
	@handler createOpportunity
	post /opportunities (OpportunityCreateReq) returns (SimpleResp)

	@doc "商机阶段推进(perm: party:opportunity:update)"
	@handler updateOpportunityStage
	put /opportunities/:id/stage (OpportunityStageReq) returns (SimpleResp)
}

// ---- 商品路由 ----
@server (
	prefix:     /api/v1
	group:      catalog
	middleware: Authz
)
service AdminBffApi {
	@doc "商品列表(perm: catalog:product:list)"
	@handler listProducts
	get /products (ProductListReq) returns (ProductListResp)

	@doc "新建商品(perm: catalog:product:create)"
	@handler createProduct
	post /products (ProductCreateReq) returns (SimpleResp)

	@doc "SKU 列表(perm: catalog:sku:list)"
	@handler listSkus
	get /skus (SkuListReq) returns (SkuListResp)

	@doc "新建 SKU(perm: catalog:sku:create)"
	@handler createSku
	post /skus (SkuCreateReq) returns (SimpleResp)

	@doc "SKU 价格列表(版本化:latest_only=价目表/false=全版本历史,perm: catalog:price:list)"
	@handler listPrices
	get /prices (PriceListReq) returns (PriceListResp)

	@doc "设置价格(新版本落库,perm: catalog:price:set)"
	@handler setPrice
	post /skus/:id/prices (PriceSetReq) returns (SimpleResp)

	@doc "质保策略 Upsert(perm: catalog:warranty:update)"
	@handler upsertWarranty
	put /skus/:id/warranty-policy (WarrantyPolicyUpsertReq) returns (SimpleResp)

	@doc "场站模板列表(perm: catalog:station:list)"
	@handler listStationProducts
	get /station-products (StationProductListReq) returns (StationProductListResp)

	@doc "场站模板详情(含 BOM,perm: catalog:station:list)"
	@handler getStationProduct
	get /station-products/:id (IDPath) returns (StationProductDetailResp)

	@doc "新建场站模板(perm: catalog:station:create)"
	@handler createStationProduct
	post /station-products (StationProductCreateReq) returns (SimpleResp)
}

// ---- 库存路由 ----
@server (
	prefix:     /api/v1
	group:      inventory
	middleware: Authz
)
service AdminBffApi {
	@doc "仓库列表(perm: inventory:warehouse:list)"
	@handler listWarehouses
	get /warehouses (WarehouseListReq) returns (WarehouseListResp)

	@doc "新建仓库(perm: inventory:warehouse:create)"
	@handler createWarehouse
	post /warehouses (WarehouseCreateReq) returns (SimpleResp)

	@doc "库存列表(四态;low_only=低库存预警,perm: inventory:inventory:list)"
	@handler listInventory
	get /inventory (InventoryListReq) returns (InventoryListResp)

	@doc "入库(perm: inventory:stock:in)"
	@handler stockIn
	post /inventory/stock-in (StockOpReq) returns (StockOpResp)

	@doc "预留(perm: inventory:stock:reserve)"
	@handler reserveStock
	post /inventory/reserve (StockOpReq) returns (StockOpResp)

	@doc "释放(perm: inventory:stock:release)"
	@handler releaseStock
	post /inventory/release (StockOpReq) returns (StockOpResp)

	@doc "出库发货(perm: inventory:stock:deduct)"
	@handler deductStock
	post /inventory/deduct (StockOpReq) returns (StockOpResp)

	@doc "备件领用(perm: inventory:stock:spare-out)"
	@handler spareOut
	post /inventory/spare-out (StockOpReq) returns (StockOpResp)

	@doc "备件退库(perm: inventory:stock:spare-return)"
	@handler spareReturn
	post /inventory/spare-return (StockOpReq) returns (StockOpResp)

	@doc "库存流水(perm: inventory:record:list)"
	@handler listStockRecords
	get /inventory/records (StockRecordListReq) returns (StockRecordListResp)

	@doc "盘点单列表(perm: inventory:stocktake:list)"
	@handler listStocktakes
	get /stocktakes (StocktakeListReq) returns (StocktakeListResp)

	@doc "创建盘点单(快照账面,perm: inventory:stocktake:create)"
	@handler createStocktake
	post /stocktakes (StocktakeCreateReq) returns (SimpleResp)

	@doc "盘点单详情(perm: inventory:stocktake:list)"
	@handler getStocktake
	get /stocktakes/:id (IDPath) returns (StocktakeDetailResp)

	@doc "提交实盘(perm: inventory:stocktake:submit)"
	@handler submitStocktake
	post /stocktakes/:id/submit (StocktakeSubmitReq) returns (SimpleResp)

	@doc "盘点审批(通过生成账面调整流水,perm: inventory:stocktake:approve)"
	@handler approveStocktake
	post /stocktakes/:id/approve (StocktakeApproveReq) returns (SimpleResp)
}

// ---- 消息路由 ----
@server (
	prefix:     /api/v1
	group:      notification
	middleware: Authz
)
service AdminBffApi {
	@doc "消息列表(perm: notification:message:list)"
	@handler listMessages
	get /messages (MessageListReq) returns (MessageListResp)

	@doc "未读数(perm: notification:message:list)"
	@handler unreadCount
	get /messages/unread-count returns (UnreadCountResp)

	@doc "标记已读(perm: notification:message:read)"
	@handler markRead
	post /messages/:id/read (IDPath) returns (SimpleResp)

	@doc "模板列表(perm: notification:template:list)"
	@handler listTemplates
	get /notify-templates (TemplateListReq) returns (TemplateListResp)

	@doc "模板 Upsert(perm: notification:template:update)"
	@handler upsertTemplate
	post /notify-templates (TemplateUpsertReq) returns (SimpleResp)

	@doc "我的通知设置(perm: notification:setting:list)"
	@handler listNotifySettings
	get /notify-settings returns (NotifySettingListResp)

	@doc "通知设置 Upsert(perm: notification:setting:update)"
	@handler upsertNotifySetting
	post /notify-settings (NotifySettingUpsertReq) returns (SimpleResp)
}

// ---- 审计路由 ----
@server (
	prefix:     /api/v1
	group:      audit
	middleware: Authz
)
service AdminBffApi {
	@doc "操作审计(perm: audit:log:list)"
	@handler listAuditLogs
	get /audit-logs (AuditLogListReq) returns (AuditLogListResp)

	@doc "指令审计(perm: audit:cmd:list)"
	@handler listCmdLogs
	get /cmd-logs (CmdAuditListReq) returns (CmdAuditListResp)
}

// ============================================================
// S5 交易域（S5-02~04）：订单/支付/合同质保。ID/单号一律 string（E8）；金额 DECIMAL 字符串。
// ============================================================
type OrderItemInputApi {
	SkuId       string `json:"sku_id"`
	WarehouseId string `json:"warehouse_id"`
	Qty         int    `json:"qty"`
	Sn          string `json:"sn,optional"`
}

type OrderCreateReq {
	Type              string              `json:"type,options=DEVICE|STATION|PURCHASE|RETURN"`
	BuyerPartyId      string              `json:"buyer_party_id,optional"`
	Remark            string              `json:"remark,optional"`
	Items             []OrderItemInputApi `json:"items"`
	PayTimeoutMinutes int                 `json:"pay_timeout_minutes,optional"`
}

type OrderCreateResp {
	OrderId     string `json:"order_id"`
	OrderNo     string `json:"order_no"`
	TotalAmount string `json:"total_amount"`
	PayExpireAt int64  `json:"pay_expire_at"`
	SagaId      string `json:"saga_id"`
}

type OrderListReq {
	Keyword string `json:"keyword,optional"`
	Type    string `json:"type,optional"`
	Status  string `json:"status,optional"`
	Page    int    `json:"page,default=1"`
	Size    int    `json:"size,default=20"`
}

type OrderItemView {
	ItemId      string `json:"item_id"`
	SkuId       string `json:"sku_id"`
	SkuName     string `json:"sku_name"`
	Sn          string `json:"sn"`
	WarehouseId string `json:"warehouse_id"`
	Qty         int    `json:"qty"`
	UnitPrice   string `json:"unit_price"`
	Amount      string `json:"amount"`
	OutQty      int    `json:"out_qty"`
}

type OrderView {
	OrderId      string          `json:"order_id"`
	OrderNo      string          `json:"order_no"`
	Type         string          `json:"type"`
	Status       string          `json:"status"`
	BuyerPartyId string          `json:"buyer_party_id"`
	TotalAmount  string          `json:"total_amount"`
	PayExpireAt  int64           `json:"pay_expire_at"`
	PaidAt       int64           `json:"paid_at"`
	CancelReason string          `json:"cancel_reason"`
	Remark       string          `json:"remark"`
	Items        []OrderItemView `json:"items"`
	CreatedAt    int64           `json:"created_at"`
	CreatedBy    string          `json:"created_by"`
}

type OrderListResp {
	List  []OrderView `json:"list"`
	Total int         `json:"total"`
}

type OrderNoPath {
	OrderNo string `path:"no"`
}

type OrderPayReq {
	OrderNo string `path:"no"`
	Channel string `json:"channel,options=WECHAT|ALIPAY|BANK_OFFLINE"`
}

type OrderPayResp {
	PaymentNo string `json:"payment_no"`
	Status    string `json:"status"`
	PayParams string `json:"pay_params"`
}

type OrderCancelReq {
	OrderNo string `path:"no"`
	Reason  string `json:"reason,optional"`
}

type SagaStepView {
	Step    int    `json:"step"`
	Name    string `json:"name"`
	Status  string `json:"status"`
	IdemKey string `json:"idem_key"`
}

type SagaView {
	SagaId      string         `json:"saga_id"`
	OrderNo     string         `json:"order_no"`
	OrderType   string         `json:"order_type"`
	CurrentStep int            `json:"current_step"`
	Status      string         `json:"status"`
	RetryCount  int            `json:"retry_count"`
	NextRetryAt int64          `json:"next_retry_at"`
	LastError   string         `json:"last_error"`
	Steps       []SagaStepView `json:"steps"`
	UpdatedAt   int64          `json:"updated_at"`
}

type SagaResp {
	Saga SagaView `json:"saga"`
}

type SagaRetryReq {
	Id     int64  `path:"id"`
	Remark string `json:"remark,optional"`
}

type ReturnItemInputApi {
	SkuId  string `json:"sku_id"`
	Qty    int    `json:"qty"`
	Sn     string `json:"sn,optional"`
	Reason string `json:"reason,optional"`
}

type ReturnCreateReq {
	OrderNo string               `json:"order_no"`
	Items   []ReturnItemInputApi `json:"items"`
	Reason  string               `json:"reason,optional"`
}

type ReturnCreateResp {
	ReturnId string `json:"return_id"`
	ReturnNo string `json:"return_no"`
}

type ReturnNoPath {
	ReturnNo string `path:"no"`
}

type ReturnApproveReq {
	ReturnNo string `path:"no"`
	Approve  bool   `json:"approve"`
	Remark   string `json:"remark,optional"`
}

type ShipmentItemInputApi {
	SkuId string `json:"sku_id"`
	Qty   int    `json:"qty"`
	Sn    string `json:"sn,optional"`
}

type ShipmentCreateReq {
	OrderNo     string                 `json:"order_no"`
	WarehouseId string                 `json:"warehouse_id"`
	Items       []ShipmentItemInputApi `json:"items"`
	Carrier     string                 `json:"carrier,optional"`
	TrackingNo  string                 `json:"tracking_no,optional"`
}

type ShipmentCreateResp {
	ShipmentId string `json:"shipment_id"`
	ShipmentNo string `json:"shipment_no"`
}

type ShipmentNoPath {
	ShipmentNo string `path:"no"`
}

type TraceAddReq {
	ShipmentNo  string `path:"no"`
	Node        string `json:"node"`
	Description string `json:"description,optional"`
	TraceTime   int64  `json:"trace_time,optional"`
}

type ShipmentSignReq {
	ShipmentNo string `path:"no"`
	SignedBy   string `json:"signed_by"`
}

type SalesSumReq {
	From int64 `json:"from,optional"`
	To   int64 `json:"to,optional"`
}

type SalesSumResp {
	TotalAmount string `json:"total_amount"`
	OrderCount  int    `json:"order_count"`
}

// ---- 支付/退款/发票/对账 ----
type PaymentListReq {
	Keyword string `json:"keyword,optional"`
	Channel string `json:"channel,optional"`
	Status  string `json:"status,optional"`
	Page    int    `json:"page,default=1"`
	Size    int    `json:"size,default=20"`
}

type PaymentView {
	PaymentNo    string `json:"payment_no"`
	OrderNo      string `json:"order_no"`
	Channel      string `json:"channel"`
	Status       string `json:"status"`
	Amount       string `json:"amount"`
	PaidAmount   string `json:"paid_amount"`
	ChannelTxnId string `json:"channel_txn_id"`
	PayerPartyId string `json:"payer_party_id"`
	CreatedBy    string `json:"created_by"`
	ApprovedBy   string `json:"approved_by"`
	Remark       string `json:"remark"`
	PaidAt       int64  `json:"paid_at"`
	CreatedAt    int64  `json:"created_at"`
}

type PaymentListResp {
	List  []PaymentView `json:"list"`
	Total int           `json:"total"`
}

type PaymentNoPath {
	PaymentNo string `path:"no"`
}

type PaymentConfirmReq {
	PaymentNo    string `path:"no"`
	ChannelTxnId string `json:"channel_txn_id,optional"`
	PaidAmount   string `json:"paid_amount,optional"`
	Source       string `json:"source,default=MOCK"`
}

type PaymentApproveReq {
	PaymentNo string `path:"no"`
	Approve   bool   `json:"approve"`
	Remark    string `json:"remark,optional"`
}

type PaymentSettleReq {
	PaymentNo string `path:"no"`
	Remark    string `json:"remark,optional"`
}

type RefundListReq {
	Keyword string `json:"keyword,optional"`
	Status  string `json:"status,optional"`
	Page    int    `json:"page,default=1"`
	Size    int    `json:"size,default=20"`
}

type RefundView {
	RefundNo        string `json:"refund_no"`
	PaymentNo       string `json:"payment_no"`
	OrderNo         string `json:"order_no"`
	ReturnNo        string `json:"return_no"`
	Amount          string `json:"amount"`
	Channel         string `json:"channel"`
	Status          string `json:"status"`
	ChannelRefundId string `json:"channel_refund_id"`
	Reason          string `json:"reason"`
	CreatedAt       int64  `json:"created_at"`
}

type RefundListResp {
	List  []RefundView `json:"list"`
	Total int          `json:"total"`
}

type RefundCreateReq {
	PaymentNo string `json:"payment_no"`
	Amount    string `json:"amount"`
	ReturnNo  string `json:"return_no,optional"`
	Reason    string `json:"reason,optional"`
}

type RefundCreateResp {
	RefundNo string `json:"refund_no"`
	Status   string `json:"status"`
}

type InvoiceListReq {
	Keyword string `json:"keyword,optional"`
	Status  string `json:"status,optional"`
	Page    int    `json:"page,default=1"`
	Size    int    `json:"size,default=20"`
}

type InvoiceView {
	InvoiceNo     string `json:"invoice_no"`
	PaymentNo     string `json:"payment_no"`
	OrderNo       string `json:"order_no"`
	Title         string `json:"title"`
	TaxNo         string `json:"tax_no"`
	Amount        string `json:"amount"`
	Status        string `json:"status"`
	ReverseReason string `json:"reverse_reason"`
	IssuedAt      int64  `json:"issued_at"`
	CreatedAt     int64  `json:"created_at"`
}

type InvoiceListResp {
	List  []InvoiceView `json:"list"`
	Total int           `json:"total"`
}

type InvoiceCreateReq {
	PaymentNo string `json:"payment_no"`
	Title     string `json:"title"`
	TaxNo     string `json:"tax_no,optional"`
	Amount    string `json:"amount,optional"`
}

type InvoiceCreateResp {
	InvoiceNo string `json:"invoice_no"`
}

type InvoiceNoPath {
	InvoiceNo string `path:"no"`
}

type InvoiceReverseReq {
	InvoiceNo string `path:"no"`
	Reason    string `json:"reason,optional"`
}

type ReconcileListReq {
	Status string `json:"status,optional"`
	Page   int    `json:"page,default=1"`
	Size   int    `json:"size,default=20"`
}

type ReconcileTaskView {
	TaskId        string `json:"task_id"`
	TaskNo        string `json:"task_no"`
	Type          string `json:"type"`
	BizDate       string `json:"biz_date"`
	DiffReport    string `json:"diff_report"`
	Status        string `json:"status"`
	Resolution    string `json:"resolution"`
	ResolveRemark string `json:"resolve_remark"`
	ResolvedBy    string `json:"resolved_by"`
	CreatedAt     int64  `json:"created_at"`
}

type ReconcileListResp {
	List  []ReconcileTaskView `json:"list"`
	Total int                 `json:"total"`
}

type ReconcileResolveReq {
	Id         int64  `path:"id"`
	Resolution string `json:"resolution,options=REPLAY|IGNORE"`
	Remark     string `json:"remark,optional"`
}

// ---- 合同/质保/SLA/索赔/延保 ----
type ContractListReq {
	Keyword string `json:"keyword,optional"`
	Type    string `json:"type,optional"`
	Status  string `json:"status,optional"`
	Page    int    `json:"page,default=1"`
	Size    int    `json:"size,default=20"`
}

type ContractFileView {
	FileRecId     string `json:"file_rec_id"`
	FileId        string `json:"file_id"`
	FileName      string `json:"file_name"`
	Version       int    `json:"version"`
	SignPartyName string `json:"sign_party_name"`
	SignPartyType string `json:"sign_party_type"`
	Status        string `json:"status"`
	UploadedBy    string `json:"uploaded_by"`
	UploaderName  string `json:"uploader_name"`
	UploadedAt    int64  `json:"uploaded_at"`
	Remark        string `json:"remark"`
}

type ContractView {
	ContractId  string             `json:"contract_id"`
	ContractNo  string             `json:"contract_no"`
	Type        string             `json:"type"`
	Status      string             `json:"status"`
	Name        string             `json:"name"`
	TemplateId  string             `json:"template_id"`
	Amount      string             `json:"amount"`
	Files       []ContractFileView `json:"files"`
	EffectiveAt int64              `json:"effective_at"`
	ArchivedAt  int64              `json:"archived_at"`
	Remark      string             `json:"remark"`
	CreatedAt   int64              `json:"created_at"`
	CreatedBy   string             `json:"created_by"`
}

type ContractListResp {
	List  []ContractView `json:"list"`
	Total int            `json:"total"`
}

type ContractNoPath {
	ContractNo string `path:"no"`
}

type ContractFileUploadReq {
	ContractNo    string `path:"no"`
	FileId        string `json:"file_id"`
	FileName      string `json:"file_name"`
	SignPartyName string `json:"sign_party_name,optional"`
	SignPartyType string `json:"sign_party_type,optional"`
	Remark        string `json:"remark,optional"`
}

type ContractFileUploadResp {
	Version int `json:"version"`
}

type ContractArchiveReq {
	ContractNo string `path:"no"`
	Action     string `json:"action,options=EFFECTIVE|ARCHIVE"`
	Remark     string `json:"remark,optional"`
}

type WarrantyListReq {
	Status string `json:"status,optional"`
	Level  string `json:"level,optional"`
	Page   int    `json:"page,default=1"`
	Size   int    `json:"size,default=20"`
}

type WarrantyView {
	WarrantyNo string `json:"warranty_no"`
	Level      string `json:"level"`
	TargetType string `json:"target_type"`
	TargetId   string `json:"target_id"`
	TargetKey  string `json:"target_key"`
	Status     string `json:"status"`
	StartAt    int64  `json:"start_at"`
	EndAt      int64  `json:"end_at"`
	Months     int    `json:"months"`
	StartRule  string `json:"start_rule"`
	SourceType string `json:"source_type"`
	SourceNo   string `json:"source_no"`
	CreatedAt  int64  `json:"created_at"`
}

type WarrantyListResp {
	List  []WarrantyView `json:"list"`
	Total int            `json:"total"`
}

type WarrantyTargetReq {
	TargetType string `json:"target_type,options=DEVICE|STATION"`
	TargetId   string `json:"target_id,optional"`
	Sn         string `json:"sn,optional"`
}

type WarrantyTargetResp {
	List []WarrantyView `json:"list"`
}

type SlaStrategyView {
	StrategyId      string `json:"strategy_id"`
	Code            string `json:"code"`
	Name            string `json:"name"`
	Level           string `json:"level"`
	ResponseMinutes int    `json:"response_minutes"`
	ResolveMinutes  int    `json:"resolve_minutes"`
	CreatedAt       int64  `json:"created_at"`
}

type SlaListResp {
	List []SlaStrategyView `json:"list"`
}

type SlaCreateReq {
	Code            string `json:"code"`
	Name            string `json:"name"`
	Level           string `json:"level"`
	ResponseMinutes int    `json:"response_minutes"`
	ResolveMinutes  int    `json:"resolve_minutes"`
}

type SlaCreateResp {
	StrategyId string `json:"strategy_id"`
}

type SlaBindReq {
	ContractNo string `path:"no"`
	StrategyId string `json:"strategy_id"`
}

type ClaimListReq {
	Status string `json:"status,optional"`
	Page   int    `json:"page,default=1"`
	Size   int    `json:"size,default=20"`
}

type ClaimView {
	ClaimNo     string `json:"claim_no"`
	WarrantyId  string `json:"warranty_id"`
	WarrantyNo  string `json:"warranty_no"`
	Type        string `json:"type"`
	Description string `json:"description"`
	Status      string `json:"status"`
	SettleType  string `json:"settle_type"`
	Amount      string `json:"amount"`
	CreatedAt   int64  `json:"created_at"`
}

type ClaimListResp {
	List  []ClaimView `json:"list"`
	Total int         `json:"total"`
}

type ClaimCreateReq {
	WarrantyId  string `json:"warranty_id"`
	Type        string `json:"type,options=QUALITY|TRANSPORT|INSTALL"`
	Description string `json:"description,optional"`
}

type ClaimCreateResp {
	ClaimId string `json:"claim_id"`
	ClaimNo string `json:"claim_no"`
}

type ClaimNoPath {
	ClaimNo string `path:"no"`
}

type ClaimApproveReq {
	ClaimNo string `path:"no"`
	Approve bool   `json:"approve"`
	Remark  string `json:"remark,optional"`
}

type ClaimSettleReq {
	ClaimNo    string `path:"no"`
	SettleType string `json:"settle_type,options=REPAIR|REPLACE|REFUND|PAID"`
	Amount     string `json:"amount,optional"`
}

type ExtensionSellReq {
	BaseWarrantyId string `json:"base_warranty_id"`
	Months         int    `json:"months"`
	OrderNo        string `json:"order_no,optional"`
	Amount         string `json:"amount,optional"`
}

type ExtensionSellResp {
	ExtensionId string `json:"extension_id"`
	ExtensionNo string `json:"extension_no"`
}

type ExtensionNoPath {
	ExtensionNo string `path:"no"`
}

type ExtensionTransferReq {
	ExtensionNo  string `path:"no"`
	ToTargetType string `json:"to_target_type,options=DEVICE|STATION"`
	ToTargetId   string `json:"to_target_id,optional"`
	ToTargetKey  string `json:"to_target_key,optional"`
}

type ExtensionRefundReq {
	ExtensionNo string `path:"no"`
	Reason      string `json:"reason,optional"`
}

// ---- 订单路由 ----
@server (
	prefix:     /api/v1
	group:      order
	middleware: Authz
)
service AdminBffApi {
	@doc "订单列表(perm: trade:order:list)"
	@handler listOrders
	get /orders (OrderListReq) returns (OrderListResp)

	@doc "订单详情含明细(perm: trade:order:list)"
	@handler getOrder
	get /orders/:no (OrderNoPath) returns (OrderView)

	@doc "创建订单(Saga 步骤1, perm: trade:order:create)"
	@handler createOrder
	post /orders (OrderCreateReq) returns (OrderCreateResp)

	@doc "发起支付(Saga 步骤3, perm: trade:order:pay)"
	@handler payOrder
	post /orders/:no/pay (OrderPayReq) returns (OrderPayResp)

	@doc "取消订单(补偿释放库存, perm: trade:order:cancel)"
	@handler cancelOrder
	post /orders/:no/cancel (OrderCancelReq) returns (SimpleResp)

	@doc "Saga 进度(perm: trade:order:list)"
	@handler getOrderSaga
	get /orders/:no/saga (OrderNoPath) returns (SagaResp)

	@doc "Saga 人工重推(perm: trade:order:retry)"
	@handler retrySaga
	post /sagas/:id/retry (SagaRetryReq) returns (SimpleResp)

	@doc "已支付销售汇总(perm: trade:order:list)"
	@handler sumPaidSales
	get /sales-summary (SalesSumReq) returns (SalesSumResp)

	@doc "退货申请(perm: trade:return:create)"
	@handler createReturnOrder
	post /return-orders (ReturnCreateReq) returns (ReturnCreateResp)

	@doc "退货审批(通过→自动退款, perm: trade:return:approve)"
	@handler approveReturnOrder
	post /return-orders/:no/approve (ReturnApproveReq) returns (SimpleResp)

	@doc "创建发货单(perm: trade:shipment:create)"
	@handler createShipment
	post /shipments (ShipmentCreateReq) returns (ShipmentCreateResp)

	@doc "轨迹手工录入(perm: trade:shipment:trace)"
	@handler addShipmentTrace
	post /shipments/:no/traces (TraceAddReq) returns (SimpleResp)

	@doc "签收确认(触发质保起算, perm: trade:shipment:sign)"
	@handler confirmShipmentSigned
	post /shipments/:no/confirm-signed (ShipmentSignReq) returns (SimpleResp)
}

// ---- 支付路由 ----
@server (
	prefix:     /api/v1
	group:      finance
	middleware: Authz
)
service AdminBffApi {
	@doc "支付单列表(REVIEWING 高亮, perm: finance:payment:list)"
	@handler listPayments
	get /payments (PaymentListReq) returns (PaymentListResp)

	@doc "支付确认(dev 模拟网关/回调, perm: finance:payment:confirm)"
	@handler confirmPayment
	post /payments/:no/confirm (PaymentConfirmReq) returns (SimpleResp)

	@doc "对公第二人复核(职责分离, perm: finance:payment:approve)"
	@handler approvePayment
	post /payments/:no/approve (PaymentApproveReq) returns (SimpleResp)

	@doc "对账核销(perm: finance:payment:settle)"
	@handler settlePayment
	post /payments/:no/settle (PaymentSettleReq) returns (SimpleResp)

	@doc "退款列表(perm: finance:refund:list)"
	@handler listRefunds
	get /refunds (RefundListReq) returns (RefundListResp)

	@doc "手工退款(原路退回, perm: finance:refund:create)"
	@handler createRefund
	post /refunds (RefundCreateReq) returns (RefundCreateResp)

	@doc "发票列表(perm: finance:invoice:list)"
	@handler listInvoices
	get /invoices (InvoiceListReq) returns (InvoiceListResp)

	@doc "开票(perm: finance:invoice:issue)"
	@handler createInvoice
	post /invoices (InvoiceCreateReq) returns (InvoiceCreateResp)

	@doc "红冲(perm: finance:invoice:reverse)"
	@handler reverseInvoice
	post /invoices/:no/reverse (InvoiceReverseReq) returns (SimpleResp)

	@doc "对账任务列表(perm: finance:reconcile:list)"
	@handler listReconcileTasks
	get /reconcile-tasks (ReconcileListReq) returns (ReconcileListResp)

	@doc "对账任务处理(仅 REPLAY/IGNORE, perm: finance:reconcile:resolve)"
	@handler resolveReconcileTask
	post /reconcile-tasks/:id/resolve (ReconcileResolveReq) returns (SimpleResp)
}

// ---- 合同质保路由 ----
@server (
	prefix:     /api/v1
	group:      contract
	middleware: Authz
)
service AdminBffApi {
	@doc "合同列表(perm: contract:contract:list)"
	@handler listContracts
	get /contracts (ContractListReq) returns (ContractListResp)

	@doc "合同详情(归档件版本列表, perm: contract:contract:list)"
	@handler getContract
	get /contracts/:no (ContractNoPath) returns (ContractView)

	@doc "归档件上传登记(受控下载经 file 服务, perm: contract:contract:archive)"
	@handler uploadContractFile
	post /contracts/:no/files (ContractFileUploadReq) returns (ContractFileUploadResp)

	@doc "合同生效/归档(perm: contract:contract:archive)"
	@handler archiveContract
	post /contracts/:no/archive (ContractArchiveReq) returns (SimpleResp)

	@doc "质保列表(perm: contract:warranty:list)"
	@handler listWarranties
	get /warranties (WarrantyListReq) returns (WarrantyListResp)

	@doc "按对象查质保(双层, perm: contract:warranty:list)"
	@handler getWarrantyByTarget
	get /warranty-by-target (WarrantyTargetReq) returns (WarrantyTargetResp)

	@doc "SLA 策略列表(perm: contract:sla:list)"
	@handler listSlaStrategies
	get /sla-strategies returns (SlaListResp)

	@doc "SLA 策略创建(perm: contract:sla:create)"
	@handler createSlaStrategy
	post /sla-strategies (SlaCreateReq) returns (SlaCreateResp)

	@doc "合同绑定 SLA(快照冻结, perm: contract:sla:bind)"
	@handler bindContractSla
	post /contracts/:no/sla (SlaBindReq) returns (SimpleResp)

	@doc "索赔列表(perm: contract:claim:list)"
	@handler listClaims
	get /claims (ClaimListReq) returns (ClaimListResp)

	@doc "索赔申请(perm: contract:claim:create)"
	@handler createClaim
	post /claims (ClaimCreateReq) returns (ClaimCreateResp)

	@doc "索赔审批(perm: contract:claim:approve)"
	@handler approveClaim
	post /claims/:no/approve (ClaimApproveReq) returns (SimpleResp)

	@doc "索赔结算(perm: contract:claim:settle)"
	@handler settleClaim
	post /claims/:no/settle (ClaimSettleReq) returns (SimpleResp)

	@doc "延保销售(衔接原质保, perm: contract:extension:sell)"
	@handler sellExtension
	post /warranty-extensions (ExtensionSellReq) returns (ExtensionSellResp)

	@doc "延保转移(perm: contract:extension:transfer)"
	@handler transferExtension
	post /warranty-extensions/:no/transfer (ExtensionTransferReq) returns (SimpleResp)

	@doc "延保退款(perm: contract:extension:refund)"
	@handler refundExtension
	post /warranty-extensions/:no/refund (ExtensionRefundReq) returns (SimpleResp)
}

